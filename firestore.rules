rules_version = '2';

// Vocab App — Firestore Security Rules
// Each user can only read/write their own document under /users/{uid}.
// Deploy manually: Firebase Console → Firestore → Rules → paste → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // User data document: /users/{uid}
    match /users/{uid} {
      // Only the authenticated owner can read or write their own document
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
